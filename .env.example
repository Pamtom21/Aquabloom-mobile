# Public values are embedded in the app. Never add service_role or database secrets.
# Include /api/v1 if that is your API prefix; the client appends /health.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Proposed scientific GET routes: keep false until Web/API agrees the contract.
# Local synthetic demonstration is opt-in from the UI and needs no API calls.
EXPO_PUBLIC_SCIENTIFIC_API_ENABLED=false
