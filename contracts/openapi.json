{
  "openapi": "3.1.0",
  "info": {
    "title": "AquaBloom API",
    "version": "0.2.0",
    "description": "Subset móvil de AquaBloomSur2do/aquabloom-sur@160cf95e95ed916e9cc9ce19244f56f268d0154d, apps/api/app/lakes.py y schemas.py. Rutas relativas a /api/v1."
  },
  "paths": {
    "/lakes": {
      "get": {
        "operationId": "listLakes",
        "summary": "Listar lagos",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de lagos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LakeListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Filtros inválidos"
          }
        }
      }
    },
    "/lakes/{lake_id}": {
      "get": {
        "operationId": "getLakeDetail",
        "parameters": [
          {
            "name": "lake_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta del catálogo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LakeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Lago inexistente"
          },
          "422": {
            "description": "Parámetros inválidos"
          },
          "503": {
            "description": "Servicio no disponible"
          }
        }
      }
    },
    "/lakes/{lake_id}/stations": {
      "get": {
        "operationId": "listLakeStations",
        "parameters": [
          {
            "name": "lake_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta del catálogo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Station"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Lago inexistente"
          },
          "422": {
            "description": "Parámetros inválidos"
          },
          "503": {
            "description": "Servicio no disponible"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Lake": {
        "type": "object",
        "required": ["id", "name", "region", "status"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          }
        }
      },
      "LakeListResponse": {
        "type": "object",
        "required": ["items", "page", "page_size", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Lake"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "LakeDetail": {
        "type": "object",
        "required": [
          "id",
          "name",
          "region",
          "status",
          "geom",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "geom": {
            "type": "object",
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Station": {
        "type": "object",
        "required": [
          "id",
          "lake_id",
          "code",
          "name",
          "point",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lake_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "point": {},
          "description": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
